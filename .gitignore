# .gitignore - hello_world Express service
# Keeps installed dependencies, local secrets, and runtime logs out of
# version control. One pattern per line.

# Dependencies (installed by `npm install`; never committed)
node_modules/

# Environment variables - local secrets/overrides.
# Only the real ".env" is ignored; ".env.example" remains tracked as the
# committed template documenting the supported variables.
.env

# Logs - winston application logs and PM2 output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PM2 process manager runtime state
.pm2/

# Test coverage reports
coverage/

# OS-generated files
.DS_Store
