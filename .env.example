# Environment variable template for the hello_world Express service.
# Copy this file to ".env" (which is git-ignored) and adjust values as needed:
#   cp .env.example .env
# All variables below are optional; the application falls back to these same
# defaults (see src/config/index.js) when a value is not provided.

# Port the HTTP server binds to.
PORT=3000

# Host / network interface the HTTP server binds to.
HOST=127.0.0.1

# Runtime environment: development | production | test.
NODE_ENV=development

# Application log verbosity (winston levels): error | warn | info | http | verbose | debug | silly.
LOG_LEVEL=info
